---
pagination:
  data: collections.tpt2Log
  size: 1
  alias: monthlyData
  addAllPagesToCollections: true
permalink: /tpt2/{{ monthlyData.monthKey | getMonthName }}-{{ monthlyData.monthKey | getYear }}.html
eleventyExcludeFromCollections: ["tpt2Log"]
eleventyComputed:
  title: "{{ monthlyData.monthKey | getMonthName }} {{ monthlyData.monthKey | getYear }} - My Theme Park Tycoon 2 Buildlog"
  description: "Entries of My Theme Park Tycoon 2 Buildlog for the month of {{ monthlyData.monthKey | getMonthName }} {{ monthlyData.monthKey | getYear }}."
  ogImage: "{{ monthMetadata[monthlyData.monthKey].ogImage }}"
  ogDescription: "Come see what I built in Theme Park Tycoon 2 on Roblox in {{ monthlyData.monthKey | getMonthName }} {{ monthlyData.monthKey | getYear }}! {{ monthMetadata[monthlyData.monthKey].ogDescription }}"
  summaryLargeImage: true
  noSitemap: false
  changefreq: monthly
  priority: 0.6
---
{% import "components.njk" as c %}
{% set previousMonth = pagination.href.next %} {# Because the entries are reversed #}
{% set nextMonth = pagination.href.previous %}

<h1>My Theme Park Tycoon 2 Buildlog - {{ monthlyData.monthKey | getMonthName }} {{ monthlyData.monthKey | getYear }}</h1>
{% call c.articleSelect(pagination, previousMonth, nextMonth, 0, "Select month") %}
    {% for page in pagination.pages %}
      {% set pageMonth = page.monthKey | getMonthName %}
      {% set pageYear = page.monthKey | getYear %}
      <option value="{{ pageMonth }}-{{ pageYear }}.html">{{ pageMonth }} {{ pageYear }}</option>
    {% endfor %}
{% endcall %}

<nav class="text-box">
  <ul>
    {% for entry in monthlyData.entries %}
    <li><a href="#{{ entry.data.title }}">{{ entry.data.date | postDate }}</a></li>
    {% endfor %}
  </ul>
</nav>

{% for entry in monthlyData.entries %}
<article>
  <h2 id="{{ entry.data.title }}">{{ entry.data.date | postDate }} <a href="#{{ entry.data.title }}" class="white-link" title="Direct link"><i class="fa-solid fa-link"></i></a></h2>
  <div class="text-box">
    {{ entry.content | safe }}
  </div>
</article>
{% endfor %}

{% call c.articleSelect(pagination, previousMonth, nextMonth, 0, "Select month") %}
    {% for page in pagination.pages %}
      {% set pageMonth = page.monthKey | getMonthName %}
      {% set pageYear = page.monthKey | getYear %}
      <option value="{{ pageMonth }}-{{ pageYear }}.html">{{ pageMonth }} {{ pageYear }}</option>
    {% endfor %}
{% endcall %}

<script src="/scripts/articleDropdownSelect.js" defer></script>
