---
layout: layouts/silver-scripts.html
pagination:
  data: collections.silverScripts
  size: 1
  alias: comic
  addAllPagesToCollections: true
permalink: /silverscripts/{{ comic.data.pgNum }}-{{ comic.data.title | slugify }}.html
eleventyComputed:
    title: "{{ comic.data.pgNum }}. {{ comic.data.title | safe }}"
    description: "Comic {{ comic.data.pgNum }} of Silver Scripts, a Sonic the Hedgehog semi-autobiographical fan webcomic about Silver the Hedgehog as computer science student."
    ogImage: comics/comic{{ comic.data.pgNum }}.png
    ogImageWidth: "{{ comic.data.stripWidth }}"
    ogImageHeight: "{{ comic.data.stripHeight }}"
    ogImageAlt: "{{ comic.data.altText }}"
    ogDescription: "A Sonic the Hedgehog semi-autobiographical fan webcomic about Silver the Hedgehog as computer science student."
    summaryLargeImage: true
    noSitemap: false
    changefreq: monthly
    priority: 0.8
---
{% import "components/silver-scripts.njk" as c %}
{% set firstComic = pagination.href.first %} {# Because the entries are reversed #}
{% set previousComic = pagination.href.previous %}
{% set nextComic = pagination.href.next %}
{% set lastComic = pagination.href.last %}
{% set totalComics = pagination.pages.length %}

<!--Schema-->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ComicStory",
    "name": "{{ title }}",
    "author": {
        "@type": "Person",
        "name": "PrincessPandaLover",
        "url": "https://princesspandalover.com"
    },
    "datePublished": "{{ comic.data.date | schemaDate }}",
    "isPartOf": {
        "@type" : "ComicSeries",
        "name": "Silver Scripts",
        "url": "https://princesspandalover.com/silverscripts/"
    },
    "url": "https://princesspandalover.com{{ page.url | lower | stripExtension }}",
    "image": {
      "@type": "ImageObject",
      "@id": "https://princesspandalover.com/silverscripts/img/{{ ogImage }}",
      "url": "https://princesspandalover.com/silverscripts/img/{{ ogImage }}",
      "height": "{{ ogImageHeight }}",
      "width": "{{ ogImageWidth }}"
    }
}
</script>

<article class="h-entry">
<div id="showComic">
    <h1 class="p-name">{{ comic.data.pgNum }}. {{ comic.data.title }}</h1>
    <a class="p-author h-card" href="/" hidden aria-hidden="true">PrincessPandaLover</a>
    {%- set titleSlug = comic.data.title | slugify %}
    {%- set comicURL = "https://princesspandalover.com/silverscripts/" + comic.data.pgNum + "-" + titleSlug %}
    <a class="u-url u-uid" href="{{ comicURL }}" hidden aria-hidden="true">{{ comicURL }}</a>

    <div class="comicInfo">
        <span class="comicArc">{{ c.comicsArcName(comic.data.tags) }}</span> <span>|</span> <span class="comicDate dt-published">{{ comic.date | postDate}}</span>
    </div>

    {{ c.nav(pagination, comic.data.pgNum, totalComics, firstComic, previousComic, nextComic, lastComic) }}

    <div class="comicPage e-content">
        <img class="u-photo" alt="{{ comic.data.altText }}" title="{{ comic.data.altText }}" src="img/comics/comic{{ comic.data.pgNum }}.png"  loading="eager" fetchpriority="high" />
    </div>
    <div class="viewOGImg">
        <a href="img/comics/comic{{ comic.data.pgNum }}.png">View original image file</a>
    </div>
</div>

{{ c.nav(pagination, comic.data.pgNum, totalComics, firstComic, previousComic, nextComic, lastComic) }}

<div id="authorNotes" class="e-content">
    <h2>Notes</h2>
    {{ comic.templateContent | safe }}
</div>
</article>

<div id="updatesSection">
    <div>
        <a href="feed.xml"><i class="fa-solid fa-rss"></i> Stay up to date with the RSS feed!</a>
    </div>
    <div>
        <a href="https://archiveofourown.org/works/61844626/chapters/158132137"><img eleventy:ignore src="/images/link-icons/archive-of-our-own.svg" class="svgColor" width="25" height="17" aria-hidden="true"/> Read on Archive of Our Own!</a><br/>
        <span style="font-family: 'Source Code Pro'; font-size: 12px"><i>(Site is not recommended for children)</i></span>
    </div>
</div>

<script src="https://kit.fontawesome.com/eee9ee52d0.js" crossorigin="anonymous" defer></script>
