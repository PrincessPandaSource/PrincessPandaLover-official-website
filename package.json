{
  "name": "princesspandalover-official-website",
  "version": "1.0.0",
  "description": "PrincessPandaLover's official website",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all build --parallel 11ty:watch wrangler:dev",
    "build": "npx @11ty/eleventy",
    "clean": "rmdir /s /q _site",
    "11ty:watch": "npx @11ty/eleventy --watch --ignore-initial",
    "wrangler:dev": "npx wrangler dev --live-reload",
    "build:prod": "cross-env ENVIRONMENT=production npx @11ty/eleventy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrincessPandaSource/PrincessPandaLover-official-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/PrincessPandaSource/PrincessPandaLover-official-website/issues"
  },
  "homepage": "https://github.com/PrincessPandaSource/PrincessPandaLover-official-website",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "cross-env": "^10.1.0",
    "eleventy-plugin-git-commit-date": "^1.0.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "wrangler": "^4.97.0"
  }
}
